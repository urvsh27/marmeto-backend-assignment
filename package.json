{
  "name": "marmeto-backend-assignment",
  "version": "1.0.0",
  "private": true,
  "description": "Webhook to courier shipment service: idempotent intake, background worker, retries",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,worker,mock -c blue,green,yellow \"npm:dev:api\" \"npm:dev:worker\" \"npm:mock\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "mock": "node mock-courier.js",
    "migrate": "tsx src/db/migrate.ts",
    "send-webhook": "tsx scripts/send-webhook.ts",
    "replay": "tsx scripts/replay.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.12",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
